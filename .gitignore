# GitHub issue #1 is authoritative; these are local drafting/research copies.
# Keep design, ADRs, research summaries and security reports under version control.
/docs/issues/
/docs/grill.md
/docs/research/oss-evidence.json

# Raw emulator/device evidence can contain local paths and device metadata.
# Only these reviewed, compact result summaries are intended for publication.
/docs/evidence/*
!/docs/evidence/2026-09-12/
/docs/evidence/2026-09-12/*
!/docs/evidence/2026-09-12/artifacts.json
!/docs/evidence/2026-09-12/receiver-assertions.json
